<odoo>
    <data>

        <record id="okticket_view_grouping_company_form" model="ir.ui.view" >
            <field name="name">okticket.view.grouping.company.form</field>
            <field name="model">res.company</field>
            <field name="inherit_id" ref="okticket_connector.okticket_view_company_form"/>
            <field name="type">form</field>
            <field name="arch" type="xml">
                  <xpath expr="//page[@name='okticket_conn_conf']" position="inside">
                    <group>
                        <field name="month_day_limit"
                               attrs="{'invisible': [('expense_sheet_grouping_time', '!=', 'biweekly')],'required': [('expense_sheet_grouping_time', '=', 'biweekly')]}"/>
                        <!--<field name="sheet_name_format"
                               attrs="{'invisible': [('expense_sheet_grouping_time', '!=', 'biweekly')],'required': [('expense_sheet_grouping_time', '=', 'biweekly')]}"/>-->
                    </group>
                 </xpath>
            </field>
        </record>

    </data>
</odoo>
