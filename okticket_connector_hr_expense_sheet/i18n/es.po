#. module: okticket_connector_hr_expense_sheet
#. odoo-python
#: code:addons/okticket_connector_hr_expense_sheet/models/okticket_hr_expense_sheet.py:0
msgid ""
"\n"
"Expense sheet %(sheet)s (Odoo id %(sheet_id)s): none of the %(total)s expenses of this run could be linked to OkTicket report %(report)s. %(reason)s"
msgstr ""
"\n"
"Hoja de gastos %(sheet)s (id de Odoo %(sheet_id)s): ninguno de los %(total)s gastos de esta ejecución se pudo vincular al informe %(report)s de OkTicket. %(reason)s"

#. module: okticket_connector_hr_expense_sheet
#. odoo-python
#: code:addons/okticket_connector_hr_expense_sheet/models/okticket_hr_expense_sheet.py:0
msgid " The report holds no expense and is deleted."
msgstr " El informe no contiene ningún gasto y se elimina."

#. module: okticket_connector_hr_expense_sheet
#. odoo-python
#: code:addons/okticket_connector_hr_expense_sheet/models/okticket_hr_expense_sheet.py:0
msgid ""
" The report is kept: it still holds %(held)s expenses linked in earlier "
"runs, and deleting it would remove them from OkTicket too. The expenses of "
"this run stay on the Odoo sheet with no OkTicket counterpart, so the two "
"sides differ for those lines."
msgstr ""
" El informe se conserva: todavía contiene %(held)s gastos vinculados en "
"ejecuciones anteriores, y borrarlo los eliminaría también de OkTicket. Los "
"gastos de esta ejecución se quedan en la hoja de Odoo sin contrapartida en "
"OkTicket, así que las dos partes difieren en esas líneas."

