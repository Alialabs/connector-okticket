<odoo>
    <data>

        <record id="view_okticket_backend_form" model="ir.ui.view">
            <field name="name">okticket.backend.form</field>
            <field name="model">okticket.backend</field>
            <field name="arch" type="xml">
                <form string="Okticket Backend">
                    <sheet>
                        <label for="name" class="oe_edit_only"/>
                        <h1>
                            <field name="name" class="oe_inline"/>
                        </h1>
                        <group name="okticket" string="Okticket Configuration"
                               groups="okticket_connector.group_okticket_conn_user">
                            <group>
                                <field name="location"/>
<!--                                <field name="key"/>-->
                                <button name="check_auth"
                                        type="object"
                                        class="oe_highlight"
                                        string="Test Authentication"/>
                            </group>
                            <group>
                                <!-- Campos vacíos para balancear -->
                                <div invisible="1"/>
                                <div invisible="1"/>
                                <div invisible="1"/>
                            </group>

                            <separator string="OkTicket Test Parameters" colspan="2"/>

                            <group>
                                <field name="http_client_conn_url"/>
                                <field name="auth_uri"/>
                                <field name="image_base_url"/>
                                <field name="api_password"/>
                                <field name="oauth_client_id"/>
                                <field name="https"/>
                                <field name="version"/>
                                <field name="company_id"/>
                                <field name="okticket_company_id"/>
                            </group>
                            <group>
                                <field name="base_url"/>
                                <field name="uri_op_path"/>
                                <field name="api_login"/>
                                <field name="grant_type"/>
                                <field name="oauth_secret"/>
                                <field name="scope"/>
                                <field name="default_lang_id"/>
                                <field name="active"/>
                            </group>
                        </group>

                        <separator/>

                        <group name="expense_config" string="Expenses import Configuration"
                               groups="okticket_connector.group_okticket_conn_user">
                            <group>
                                <field name="import_expenses_since"/>
                                <field name="import_only_reviewed_expenses"/>
                            </group>
                            <group>
                                <field name="ignore_import_expenses_since"/>
                            </group>
                        </group>

                        <separator/>

                        <notebook name="bindings">
                            <page string="Expenses Bindings" name="hr_expense_bindings">
                                <button name="%(action_open_okticket_hr_expense_binding)d"
                                        string="⇒ See Hr Expense Bindings"
                                        type="action"
                                        class="oe_link"/>
                                <field name="okticket_hr_expense_ids" invisible="1">
                                    <list editable="top" limit="80">
                                        <field name="id"/>
                                        <field name="sync_date"/>
                                        <field name="odoo_id"/>
                                        <field name="external_id"/>
                                        <field name="backend_id" invisible="1"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>

                        <separator/>

                        <button name="%(action_open_okticket_log)d"
                                string="⇒ See Backend Logs"
                                type="action"
                                class="oe_link"/>

                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_okticket_backend_list" model="ir.ui.view">
            <field name="name">okticket.backend.list</field>
            <field name="model">okticket.backend</field>
            <field name="arch" type="xml">
                <list string="Okticket Backend">
                    <field name="name"/>
                    <field name="location"/>
                </list>
            </field>
        </record>

        <record id="action_okticket_backend" model="ir.actions.act_window">
            <field name="name">Okticket Backend</field>
            <field name="res_model">okticket.backend</field>
            <field name="view_mode">list,form</field>
            <field name="view_id" ref="view_okticket_backend_list"/>
        </record>

    </data>
</odoo>