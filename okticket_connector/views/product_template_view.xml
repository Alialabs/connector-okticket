<odoo>
    <data>

        <record id="okticket_product_template_form_view" model="ir.ui.view">
            <field name="name">okticket.product.template.common.form</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_form_view"/>
            <field name="arch" type="xml">
                <notebook position="inside">
                    <page name="okticket_conn_conf" string="OkTicket Conf.">
                        <group>
                            <field name="okticket_categ_prod_id" string="Category_id"/>
                            <field name="okticket_type_prod_id" string="Type_id"/>
                        </group>
                        <group string="Rebillable Info">
                            <field name="rebillable_prod_id"/>
                            <field name="no_rebillable_prod_ids" widget="many2many_tags" readonly="1"/>
                        </group>
                        <group string="Invoice version Info">
                            <field name="invoice_prod_id"/>
                            <field name="base_version_prod_ids" widget="many2many_tags" readonly="1"/>
                        </group>
                        <separator string="Tax Mapping"/>
                        <p class="text-muted">
                            Which Odoo tax each rate OkTicket reports means for this
                            product. Only needed where the tax the connector resolves
                            on its own is not the right one: it always picks the
                            domestic tax of the product's scope, and every expense
                            product is typed as a service, so a rate that is goods
                            here has to be stated. A row on the base product also
                            applies to its invoice and rebillable versions.
                        </p>
                        <field name="okticket_tax_mapping_ids">
                            <tree editable="bottom">
                                <field name="company_id" optional="hide"/>
                                <field name="okticket_rate"/>
                                <field name="tax_id"/>
                            </tree>
                        </field>
                    </page>
                </notebook>
            </field>
        </record>

    </data>
</odoo>
