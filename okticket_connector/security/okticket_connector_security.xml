<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record model="ir.module.category" id="module_category_okticket_connector">
        <field name="name">Okticket Connector Management</field>
        <field name="description">Okticket Connector Operations</field>
        <field name="sequence">50</field>
    </record>

    <!-- In Odoo 19 res.groups no longer has category_id; groups are grouped in
         the UI through a res.groups.privilege that points to the category. -->
    <record model="res.groups.privilege" id="privilege_okticket_connector">
        <field name="name">Okticket Connector</field>
        <field name="category_id" ref="module_category_okticket_connector" />
    </record>

    <record id="group_okticket_conn_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="privilege_okticket_connector" />
        <field
      name="implied_ids"
      eval="[(4, ref('connector.group_connector_manager'))]"
    />
    </record>

    <record id="group_okticket_conn_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="privilege_okticket_connector" />
        <field
      name="implied_ids"
      eval="[(4, ref('group_okticket_conn_user')), (4, ref('connector.group_connector_manager'))]"
    />

    </record>

    <record id="okticket_backend_company_rule" model="ir.rule">
        <field name="name">Okticket Backend Multi-Company</field>
        <field name="model_id" ref="model_okticket_backend" />
        <field
      name="domain_force"
    >['|',('company_id','=',False),('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
