<odoo>

    <template id="report_img_expense">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="expense">
                    <t t-call="okticket_hr_expense_reporting.okticket_external_layout">
                    <div class="page">
                      <div style="text-align:center;font-family: helvetica;">
                        <t t-if="expense.analytic_account_id">
                          <p class="text-uppercase">
                            <strong>
                              <span t-field="expense.analytic_account_id.name"/>
                            </strong>
                            <br/>
                          </p>
                        </t>
                        <t t-if="expense.product_id">
                          <p class="text-uppercase">
                            <span t-field="expense.product_id.name"/>
                          </p>
                        </t>
                      </div>
                      <div style="text-align:center;font-family: helvetica;">
                        <t t-if="expense.okticket_img">
                          <img t-if="expense.okticket_img" t-attf-src="data:image/*;base64,{{expense.okticket_img}}" style="max-height: 750px;"/>
                        </t>
                        <t t-else="">
                            <strong>
                                <i>
                                  <p class="text-danger">
                                  IMG N.A.
                                  </p>
                                </i>
                            </strong>
                        </t>
                      </div>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <!-- The <report> shorthand was dropped in Odoo 17: it is neither in
         import_xml.rng nor handled by convert.py any more, so the module simply
         would not install. Declared as the ir.actions.report record it always
         produced, with binding_model_id/binding_type so it keeps showing up in
         the record's Print menu. -->
    <record id="action_report_img_hr_expense" model="ir.actions.report">
        <field name="name">Expenses Image Report</field>
        <field name="model">hr.expense</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">okticket_hr_expense_reporting.report_img_expense</field>
        <field name="report_file">okticket_hr_expense_reporting.report_img_expense</field>
        <field name="print_report_name">'Expenses'</field>
        <field name="binding_model_id" ref="hr_expense.model_hr_expense"/>
        <field name="binding_type">report</field>
    </record>

</odoo>
